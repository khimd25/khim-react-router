# Copy to .env and fill in. Never commit your real .env or private key.

# --- Anthropic (the agent's brain) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Kalshi API credentials ---
# Create an API key in the Kalshi web UI (Settings -> API). You get a Key ID and
# download an RSA private key PEM file. Point these at them.
KALSHI_KEY_ID=your-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Use the DEMO host while testing (no real money), then switch to production.
#   Production : https://api.elections.kalshi.com
#   Demo       : https://demo-api.kalshi.co
KALSHI_API_BASE=https://demo-api.kalshi.co

# --- Optional overrides ---
# KALSHI_AGENT_MODEL=claude-opus-4-8
# KALSHI_JOURNAL_DB=./journal.db
# KALSHI_KNOWLEDGE_DIR=./knowledge
